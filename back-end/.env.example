# Port the backend server listens on
PORT=5000

# Origin allowed to make requests to this API (CORS).
# Also used as the base URL Stripe redirects back to after checkout.
# Set to your deployed frontend URL in production (e.g. https://jesus-tabora.com)
ALLOWED_ORIGIN=http://localhost:3000

# Stripe secret key (starts with sk_test_ or sk_live_) - get this from
# https://dashboard.stripe.com/apikeys once your Stripe account is set up.
# Leave blank until then - checkout will return a friendly "not set up yet" error.
STRIPE_SECRET_KEY=
