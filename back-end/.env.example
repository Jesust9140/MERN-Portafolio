# Port the backend server listens on
PORT=5000

# Origin allowed to make requests to this API (CORS).
# Also used as the base URL Stripe redirects back to after checkout.
# Set to your deployed frontend URL in production (e.g. https://jesus-tabora.com)
ALLOWED_ORIGIN=http://localhost:3000

# Stripe secret key (starts with sk_test_ or sk_live_) - get this from
# https://dashboard.stripe.com/apikeys once your Stripe account is set up.
# Leave blank until then - checkout will return a friendly "not set up yet" error.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_). For local dev, run
# `stripe listen --forward-to localhost:5000/api/stripe-webhook` with the
# Stripe CLI and it will print a secret to use here. In production, get this
# from the webhook's settings page in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Email account used to send notifications (payment confirmations, contact
# form messages, project intake submissions). Not wired up to real sending
# yet - see back-end/mailer.js - these are reserved for when that's ready.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# AWS S3 - used to store client-uploaded logos/reference images from the
# post-payment intake form. Create an S3 bucket and an IAM user scoped to
# just that bucket (s3:PutObject + s3:GetObject), then fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# MongoDB Atlas connection string - used to store intake submissions and
# admin login sessions. Create a free M0 cluster at mongodb.com/cloud/atlas,
# create a database user, allow network access, then paste the connection
# string here (include a database name before the "?", e.g. .../portfolio?...).
MONGODB_URI=

# Shared password for the private /admin dashboard. Pick something strong -
# anyone with this password can see all client submissions.
ADMIN_PASSWORD=
